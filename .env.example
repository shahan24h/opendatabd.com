# ── Supabase ──────────────────────────────────────────────────────────────────
# Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# WARNING: Never expose this key client-side
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── MinIO object storage (server-side only) ───────────────────────────────────
MINIO_ENDPOINT=https://storage.opendatabd.com
MINIO_ACCESS_KEY=your-restricted-minio-access-key
MINIO_SECRET_KEY=your-restricted-minio-secret-key
MINIO_BUCKET=opendatabd-datasets

# ── Resend ────────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_api_key_here

# Must match a verified domain in Resend
RESEND_FROM=OpenDataBD <noreply@opendatabd.com>

# ── App ───────────────────────────────────────────────────────────────────────
APP_URL=https://opendatabd.com
